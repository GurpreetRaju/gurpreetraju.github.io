@inherits LayoutComponentBase

<ToastProvider />
<div class="layout-wrapper">
    <AppBar BackgroundColor="Color.Primary">
        <BrandContent>
            <Text Typo="Typography.span" Class="brand">Gurpreet Raju</Text>
        </BrandContent>
        <ChildContent>
            <div class="flex-grow-1" />
            <NavMenu IsVertical="false">
                <NavigationItems>
                    <NavigationItem Url="/">Home</NavigationItem>
                    <NavigationItem Url="/experience">Experience</NavigationItem>
                    <NavigationItem Url="/projects">Projects</NavigationItem>
                    <NavigationItem Url="/contact">Contact</NavigationItem>
                </NavigationItems>
            </NavMenu>
            <ShineBlazor.Components.Theme.ThemeSelector Theme="_theme"  />
        </ChildContent>
    </AppBar>
    <div class="content">
        @Body
    </div>
    <Footer />
</div>

@code{
    private GurpreetTheme _theme = new ();
}
