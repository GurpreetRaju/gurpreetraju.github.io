@page "/"

<div class="intro-wrapper">
    <div class="my-image">
        <img src="images/me.jpg" class="rounded-circle" alt="GurpreetRaju"/>
    </div>
    <Text Typo="Typography.h1" Class="introduction">Hi, I am Gurpreet.</Text>
    <Text Typo="Typography.p" Class="section-intro">I'm a technology enthusiast with over 7 years of hands-on experience in software development.</Text>
</div>

<Card>
    <CardHeader>Skills</CardHeader>
    <CardBody>
        <Text Typo="Typography.p" Class="section-intro">
            I thrive on challenges and stay at the forefront of technology. My skill set includes a range of technologies and frameworks.
        </Text>
        <div class="skills-grid">
            @foreach (var skill in Skills)
            {
                <div class="skill-item">
                    <img src="@skill.Image" alt="@skill.Name" class="skill-icon" />
                    <Text Class="skill-label">@skill.Name</Text>
                </div>
            }
        </div>
        <Text Class="section-intro">
            My proficiency extends to the following:
        </Text>
        <div class="soft-skills">
            @foreach (var softSkill in SoftSkills)
            {
                <div class="soft-skill-pill">@softSkill</div>
            }
        </div>
    </CardBody>
</Card>

<Card>
    <CardHeader>Education</CardHeader>
    <CardBody Class="education-section">
        <FlipCard Logo="images/concordia_logo.png"
                  Title="Master of Engineering"
                  Institution="Concordia University"
                  Location="Montreal, QC, Canada"
                  Years="2016 - 2017"
                  Gpa="3.45"
                  Major="Software Engineering" />
        <FlipCard Logo="images/gndec_logo.png"
                  Title="Bachelor of Technology"
                  Institution="Guru Nanak Dev Engineering College"
                  Location="Ludhiana, India"
                  Years="2010 - 2014"
                  Gpa="3.0"
                  Major="Computer Science" />
        <FlipCard Logo="images/gnm_logo.jpg"
                  Title="Higher Secondary Education"
                  Institution="Guru Nanak Mission Public Sen. Sec. School"
                  Location="Dhahan Kaleran, Punjab, India"
                  Years="2010"
                  Major="Non-Medical" />
    </CardBody>
</Card>

@code {
    private (string Name, string Image)[] Skills = [
        (".NET", "images/Skills/logo_net_core.png"),
        ("ASP.Net", "images/Skills/logo_asp.png"),
        ("C#", "images/Skills/logo_c_sharp.png"),
        ("Blazor", "images/Skills/logo_blazor.png"),
        ("Angular", "images/Skills/logo_angular.png"),
        ("JavaScript", "images/Skills/logo_js.png"),
        ("SQL", "images/Skills/logo_sql.png"),
        ("Azure", "images/Skills/logo_azure.png"),
        ("Docker", "images/Skills/logo_docker.png"),
        ("Kubernetes", "images/Skills/logo_kubernetes.png")
    ];

    private string[] SoftSkills = [
        "HTML",
        "CSS",
        "GIT",
        "gRPC",
        "Redis",
        "Kafka",
        "REST API",
        "Linux",
        "Windows",
        "Design Patterns",
        "Problem Solving",
        "Team Player",
    ];
}