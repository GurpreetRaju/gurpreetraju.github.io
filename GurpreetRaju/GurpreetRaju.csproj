<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	
	<ItemGroup>
	  <Content Remove="Resources\Experience.json" />
	  <Content Remove="Resources\Projects.json" />
	</ItemGroup>
	
	<ItemGroup>
	  <EmbeddedResource Include="Resources\Experience.json" />
	  <EmbeddedResource Include="Resources\Projects.json" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Markdig" Version="0.40.0" />
		<PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.6" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.6" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.6" />
		<PackageReference Include="ShineBlazor.Components" Version="0.2.3" />
	</ItemGroup>
</Project>